# ================================================================
# PORMS - Environment Variables Template
# Copy this file to .env and fill all values before running.
# Do not commit the real .env file.
# ================================================================

# PostgreSQL
POSTGRES_PASSWORD=
POSTGRES_API_PASSWORD=
POSTGRES_ETL_PASSWORD=
POSTGRES_METABASE_PASSWORD=

# OpenWeather API
OPENWEATHER_API_KEY=
OW_BASE_URL=https://api.openweathermap.org/data/2.5

# ASP.NET Core JWT
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Internal API key used by workers to call backend endpoints
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Metabase signed embedding
# Generate with: openssl rand -hex 32
METABASE_SECRET_KEY=
