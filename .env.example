# ================================================================
# PORMS — Environment Variables Template
# Sao chép file này: cp .env.example .env
# Điền tất cả giá trị trước khi chạy docker compose
# KHÔNG commit file .env vào Git
# ================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────
# Superuser (postgres) — dùng để tạo schema, init, migrations
POSTGRES_PASSWORD=StrongPass123!


# User cho ASP.NET Core backend (đọc/ghi operational schema)
POSTGRES_API_PASSWORD=ApiPass123!

# User cho Prefect ETL worker (đọc/ghi operational schema)
POSTGRES_ETL_PASSWORD=EtlPass123!

# ─── OpenWeather API ─────────────────────────────────────────────
# Lấy free API key tại: https://openweathermap.org/api
# Free tier: 1,000 calls/ngày — đủ cho 1 port, fetch mỗi 15 phút (96 calls/ngày)
OPENWEATHER_API_KEY=
OW_BASE_URL=https://api.openweathermap.org/data/2.5

# --- SMTP email notification ---
# Bat SMTP_ENABLED=true va dien thong tin ben duoi de gui mail khi phan cong task.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PORMS
FRONTEND_BASE_URL=http://localhost:5173

# ─── JWT (ASP.NET Core) ──────────────────────────────────────────
# Tối thiểu 32 ký tự ngẫu nhiên
# Tạo bằng: openssl rand -base64 32
JWT_SECRET=jxuYL30mE2VKX72OvP4KGDcz0m6M5PpPoab3P5Fz2p0=

# ─── Internal API ────────────────────────────────────────────────
# Key để Prefect worker gọi endpoint trigger Risk Engine trên .NET
# Tạo bằng: openssl rand -hex 32
INTERNAL_API_KEY=33accc2ee0b1e07dcd32954b114ede1c79a5b453057dd455d8fe871792a279c6

# ─── Prefect ─────────────────────────────────────────────────────
# URL của Prefect server (dùng khi chạy native, không qua docker)
PREFECT_API_URL=http://localhost:4200/api
